{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug baseline-app",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/baseline-app.exe",
            "args": [],
            "cwd": "${workspaceFolder}/target/debug",
            "preLaunchTask": "build + kill stale (debug)",
            "sourceLanguages": [
                "rust"
            ],
            "env": {
                "RUST_BACKTRACE": "1"
            }
        },
        {
            "name": "Run baseline-app (Release)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/release/baseline-app.exe",
            "args": [],
            "cwd": "${workspaceFolder}/target/release",
            "preLaunchTask": "build + kill stale (release)",
            "sourceLanguages": [
                "rust"
            ]
        },
        {
            "name": "Attach to baseline-app",
            "type": "lldb",
            "request": "attach",
            "program": "${workspaceFolder}/target/debug/baseline-app.exe"
        }
    ]
}
